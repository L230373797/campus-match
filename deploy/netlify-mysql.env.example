# Copy this file to .env.production-mysql for local checks.
# Do not commit the copied file with real passwords.

MYSQL_HOST=your-rds-host.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=campus_match
MYSQL_USER=campus_app
MYSQL_PASSWORD=replace-with-cloud-mysql-password

# Turn this on if your cloud database requires TLS.
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Optional: paste your database provider's CA certificate here if required.
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
